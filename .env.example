# --- TELEGRAM BOT API CONFIGURATION ---
API_ID=0                  # Get this from https://my.telegram.org
API_HASH=""               # Get this from https://my.telegram.org
BOT_TOKEN=""              # Create using https://t.me/BotFather

# --- MONGO DATABASE CONFIGURATION ---
MONGO_URI="mongodb+srv://..."  # MongoDB Atlas connection string
DB_NAME="filestore"

# --- OWNER CONFIGURATION ---
OWNER_ID=0                # Your Telegram user ID
ADMINS=""                 # (Optional) Comma-separated extra admin IDs, e.g. "123456,789012"

# --- OPTIONAL CONFIGURATIONS ---
PORT=8080                 # Health check port for Koyeb/Render/Heroku
AUTO_DEL=300              # Delay in seconds before auto-deleting shared files
DISABLE_BTN=true          # Prevent Telegram button sharing on media forwards
PROTECT=true              # Disable forwarding/saving of bot files
CLONE_LIMIT=3             # Max cloned bots owned per user ID
CLONE_ALLOW=true             # Whether user bot cloning is enabled (true/false)
FQDN=""                   # (Optional) App FQDN (e.g. mybot.render.com) for self-ping to prevent cold starts

# --- SECURITY (ENCRYPTION) ---
# Symmetric passphrase used to encrypt cloned bot tokens in MongoDB using AES-256-GCM.
# Keep this secret! Leave blank to store tokens in raw format.
# Generate a secure key online: https://aquib4040.github.io/filestore/key_generator.html
TOKEN_ENCRYPTION_KEY=""
